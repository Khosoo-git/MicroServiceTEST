# Copy to .env and adjust (Docker Compose loads .env automatically; VS Code launch.json also uses it).
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin

# --- Docker images (registry + tag) ---
MS_IMAGE_REGISTRY=xoco0508
MS_IMAGE_TAG=latest

# --- Microservice & infra host ports ---
EUREKA_PORT=8761
CONFIG_SERVER_PORT=8080
COMPANY_MS_PORT=8081
JOB_MS_PORT=8082
REVIEW_MS_PORT=8083
GATEWAY_MS_PORT=8084

# CORS for POST /api/client-errors (browser error ingestion from third-party sites). Comma-separated patterns.
# CLIENT_ERROR_CORS_PATTERNS=*

# --- Observability host ports ---
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
TEMPO_PORT_HTTP=3200
TEMPO_PORT_GRPC=9095
TEMPO_PORT_OTLP_GRPC=4317
TEMPO_PORT_OTLP_HTTP=4318

# --- Bind-mount paths (relative to repo root) ---
LOGS_DIR=./logs
DATA_PROMETHEUS_DIR=./data/prometheus
DATA_TEMPO_DIR=./data/tempo
DATA_GRAFANA_DIR=./data/grafana

# --- Grafana auth ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_ENABLED=false

# --- Spring (passed into containers) ---
SPRING_PROFILES_ACTIVE=docker

# --- Observability UI backend targets ---
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000
NEXT_PUBLIC_GRAFANA_DASHBOARD_UID=ms-observability-overview
