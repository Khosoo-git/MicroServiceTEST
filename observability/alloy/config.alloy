// Base Alloy config: demo microservice metrics + logs
// User-registered services: /etc/alloy/dynamic/services.alloy (loaded via docker command)

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Demo microservices — always scraped (no registration required)
prometheus.scrape "demo_company" {
  targets         = [{ __address__ = "company:8081", job = "company" }]
  forward_to      = [prometheus.remote_write.default.receiver]
  job_name        = "company"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.scrape "demo_job" {
  targets         = [{ __address__ = "job:8082", job = "job" }]
  forward_to      = [prometheus.remote_write.default.receiver]
  job_name        = "job"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.scrape "demo_review" {
  targets         = [{ __address__ = "review:8083", job = "review" }]
  forward_to      = [prometheus.remote_write.default.receiver]
  job_name        = "review"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.scrape "demo_gateway" {
  targets         = [{ __address__ = "gateway:8084", job = "gateway" }]
  forward_to      = [prometheus.remote_write.default.receiver]
  job_name        = "gateway"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// Log files (shared volume with demo apps)
loki.source.file "logs" {
  targets = [
    { __path__ = "/logs/company.log", job = "company" },
    { __path__ = "/logs/job.log", job = "job" },
    { __path__ = "/logs/review.log", job = "review" },
    { __path__ = "/logs/gateway.log", job = "gateway" },
  ]
  forward_to = [loki.write.lokiwrite.receiver]
}

loki.write "lokiwrite" {
  endpoint {
    url       = "http://loki:3100/loki/api/v1/push"
    tenant_id = "fake"
  }
}

// OTLP traces: apps → Alloy → Tempo (OTLP_PUSH registered services)
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure             = true
      insecure_skip_verify = true
    }
  }
}
