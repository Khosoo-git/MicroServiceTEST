// Auto-generated by Service Registry API

prometheus.remote_write "registered" {
  endpoint { url = "http://prometheus:9090/api/v1/write" }
}

loki.write "registered" {
  endpoint {
    url       = "http://loki:3100/loki/api/v1/push"
    tenant_id = "fake"
  }
}

prometheus.scrape "svc_gateway" {
  targets         = [{ __address__ = "gateway:8084", job = "gateway" }]
  forward_to      = [prometheus.remote_write.registered.receiver]
  job_name        = "gateway"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.scrape "svc_review" {
  targets         = [{ __address__ = "review:8083", job = "review" }]
  forward_to      = [prometheus.remote_write.registered.receiver]
  job_name        = "review"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.scrape "svc_company" {
  targets         = [{ __address__ = "company:8081", job = "company" }]
  forward_to      = [prometheus.remote_write.registered.receiver]
  job_name        = "company"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.scrape "svc_job" {
  targets         = [{ __address__ = "job:8082", job = "job" }]
  forward_to      = [prometheus.remote_write.registered.receiver]
  job_name        = "job"
  metrics_path    = "/actuator/prometheus"
  scheme          = "http"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

discovery.static "http_probes" {
  targets = [
    {
      __param_target = "https://google.com",
      job            = "google",
      service        = "google",
    },
  ]
}

discovery.relabel "http_probes" {
  targets = discovery.static.http_probes.targets

  rule {
    source_labels = ["__param_target"]
    target_label  = "instance"
  }

  rule {
    target_label  = "__address__"
    replacement   = "blackbox-exporter:9115"
  }
}

prometheus.scrape "http_probes" {
  targets         = discovery.relabel.http_probes.output
  forward_to      = [prometheus.remote_write.registered.receiver]
  job_name        = "http_probe"
  metrics_path    = "/probe"
  params          = { module = ["http_2xx"] }
  scrape_interval = "30s"
  scrape_timeout  = "15s"
}

loki.source.file "registered_logs" {
  targets = [
    { __path__ = "/logs/gateway.log", job = "gateway" },
    { __path__ = "/logs/review.log", job = "review" },
    { __path__ = "/logs/company.log", job = "company" },
    { __path__ = "/logs/job.log", job = "job" },
  ]
  forward_to = [loki.write.registered.receiver]
}

